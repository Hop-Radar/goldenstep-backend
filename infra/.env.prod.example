# 이미지 경로 예시
# 배포 전 계장 ID와 이미지 태그 수정할 것
# 각 레포는 고유의 SHA commit 이 존재.
FRONTEND_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/goldenstep-frontend:REPLACE_FRONTEND_SHA
BACKEND_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/goldenstep-backend:REPLACE_BACKEND_SHA
ALGORITHM_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/goldenstep-ai:REPLACE_ALGORITHM_SHA

# 호스트 경로 예시
NGINX_CONFIG_PATH=/opt/goldenstep/nginx/default.conf
TLS_CERT_DIR=/opt/goldenstep/letsencrypt
AI_DATA_DIR=/opt/goldenstep/data
BACKEND_ENV_FILE=/opt/goldenstep/secrets/backend.env